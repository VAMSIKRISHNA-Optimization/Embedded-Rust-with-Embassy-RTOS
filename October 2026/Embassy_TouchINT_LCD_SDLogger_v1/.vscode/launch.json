{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "Flash and Debug Nucleo",
            "cwd": "${workspaceFolder}",
            "chip": "STM32F446RETx",
            "connectUnderReset": true,
            "speed": 4000,
            "env": {
                "DEFMT_LOG": "info"
            },
            "flashingConfig": {
                "flashingEnabled": true,
                "haltAfterReset": true
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "${workspaceFolder}/target/thumbv7em-none-eabihf/debug/${workspaceFolderBasename}",
                    "rttEnabled": true
                }
            ]
        }
    ]
}