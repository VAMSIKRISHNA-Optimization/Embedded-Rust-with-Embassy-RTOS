{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "Flash and Debug Nucleo",
            "cwd": "${workspaceFolder}",
            "chip": "STM32F446RETx",
            "connectUnderReset": false,
            "speed": 4000,
            "flashingConfig": {
